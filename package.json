{
  "name": "lab-book",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "A calm research workspace for papers, notes and experiments.",
  "main": "src/electron/main.cjs",
  "scripts": {
    "start": "node src/server/server.cjs",
    "test:accounts": "node --test tests/accounts.cjs tests/member-workspace.cjs tests/chatgpt-login.cjs tests/chatgpt-plan.cjs && env -u ELECTRON_RUN_AS_NODE electron tests/accounts-ui.cjs",
    "test:persistence": "env -u ELECTRON_RUN_AS_NODE electron tests/persistence.cjs",
    "test:runtime": "node --test tests/runtime.cjs",
    "test:reader": "env -u ELECTRON_RUN_AS_NODE electron tests/reader.cjs",
    "test:routes": "env -u ELECTRON_RUN_AS_NODE electron tests/routes.cjs",
    "test:library": "env -u ELECTRON_RUN_AS_NODE electron tests/library.cjs",
    "test:appearance": "env -u ELECTRON_RUN_AS_NODE electron tests/appearance.cjs",
    "test:workspace": "env -u ELECTRON_RUN_AS_NODE electron tests/workspace-pages.cjs",
    "test:research-api": "node --test tests/research-api.cjs",
    "test:research-stream-skill": "env -u ELECTRON_RUN_AS_NODE electron tests/research-stream-skill.cjs",
    "test:research-hub": "env -u ELECTRON_RUN_AS_NODE electron tests/research-hub.cjs",
    "test:demo": "node --test tests/demo-fixtures.cjs",
    "test:demo-browser": "env -u ELECTRON_RUN_AS_NODE electron tests/demo-browser.cjs",
    "test:experiment-picker": "env -u ELECTRON_RUN_AS_NODE electron tests/experiment-picker.cjs",
    "test:sidebar-forms": "env -u ELECTRON_RUN_AS_NODE electron tests/sidebar-forms.cjs",
    "test:columns": "node --test tests/table-schema.cjs",
    "test:column-editor": "env -u ELECTRON_RUN_AS_NODE electron tests/column-editor.cjs",
    "test:diagram-model": "node --test tests/diagram-service.cjs",
    "test:diagram-editor": "env -u ELECTRON_RUN_AS_NODE electron tests/diagram-editor.cjs",
    "test:column-tasks": "env -u ELECTRON_RUN_AS_NODE electron tests/column-tasks.cjs",
    "test:research-polish": "env -u ELECTRON_RUN_AS_NODE electron tests/research-polish.cjs",
    "test:search-controls": "env -u ELECTRON_RUN_AS_NODE electron tests/search-controls.cjs",
    "test:board-workspace": "env -u ELECTRON_RUN_AS_NODE electron tests/board-workspace.cjs",
    "test:inline-board": "env -u ELECTRON_RUN_AS_NODE electron tests/inline-board.cjs",
    "start:test": "node src/server/server.cjs --test",
    "start:production": "NODE_ENV=production PORT=4173 node src/server/server.cjs",
    "dev": "node src/server/server.cjs",
    "migrate:test": "node scripts/migrate-env.cjs",
    "seed:test": "node scripts/seed-test.cjs",
    "library:seed": "node scripts/seed-research.cjs",
    "reading-paths:seed": "node scripts/seed-bilingual-reading-paths.cjs",
    "reading-paths:seed:test": "node scripts/seed-bilingual-reading-paths.cjs --test",
    "sota-review": "node scripts/sota-review.cjs",
    "sota-review:test": "node scripts/sota-review.cjs --test",
    "sota-install": "node scripts/install-sota-review.cjs",
    "sota-uninstall": "node scripts/install-sota-review.cjs --uninstall",
    "workspace:clean": "node scripts/clean-production.cjs",
    "desktop": "env -u ELECTRON_RUN_AS_NODE electron .",
    "desktop:dev": "concurrently \"node src/server/server.cjs\" \"wait-on http://localhost:4173 && env -u ELECTRON_RUN_AS_NODE electron .\"",
    "package:desktop": "electron-builder",
    "test:diagram-harmonize": "node --test tests/diagram-harmonize.cjs tests/diagram-service.cjs",
    "test:diagram-chat": "env -u ELECTRON_RUN_AS_NODE electron tests/diagram-chat.cjs",
    "test:nested-pages": "env -u ELECTRON_RUN_AS_NODE electron tests/nested-pages.cjs",
    "test:skills": "env -u ELECTRON_RUN_AS_NODE electron tests/skill-manager.cjs",
    "test:attachments": "env -u ELECTRON_RUN_AS_NODE electron tests/research-attachments.cjs",
    "test:agent": "node --test tests/agent-request.cjs && env -u ELECTRON_RUN_AS_NODE electron tests/my-agent.cjs",
    "test:agent-layout": "env -u ELECTRON_RUN_AS_NODE electron tests/agent-layout.cjs",
    "test:editor-agent": "env -u ELECTRON_RUN_AS_NODE electron tests/editor-agent.cjs",
    "test:rich-pages": "node --test tests/rich-pages.cjs && env -u ELECTRON_RUN_AS_NODE electron tests/math-notes.cjs",
    "test:lifecycle": "node --test tests/lifecycle.cjs && env -u ELECTRON_RUN_AS_NODE electron tests/lifecycle-browser.cjs",
    "test:send-lock": "env -u ELECTRON_RUN_AS_NODE electron tests/agent-send-lock.cjs",
    "test:sidebar-resize": "env -u ELECTRON_RUN_AS_NODE electron tests/sidebar-resize.cjs",
    "test:proposal-destinations": "node --test tests/proposal-destinations.cjs && env -u ELECTRON_RUN_AS_NODE electron tests/proposal-destination-ui.cjs",
    "test:source-import": "node --test tests/external-pdf.cjs tests/proposal-destinations.cjs && env -u ELECTRON_RUN_AS_NODE electron tests/source-pdf-import.cjs",
    "test:page-questions": "env -u ELECTRON_RUN_AS_NODE electron tests/page-questions.cjs",
    "test": "node --test tests/runtime.cjs tests/research-api.cjs tests/table-schema.cjs tests/lifecycle.cjs tests/launch.cjs tests/source-layout.cjs",
    "test:coverage": "node --experimental-test-coverage --test tests/runtime.cjs tests/research-api.cjs tests/table-schema.cjs tests/lifecycle.cjs tests/launch.cjs tests/source-layout.cjs",
    "test:environments": "env -u ELECTRON_RUN_AS_NODE electron tests/environment-picker.cjs",
    "screenshots": "env -u ELECTRON_RUN_AS_NODE electron scripts/capture-screenshots.cjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.labbook.workspace",
    "productName": "Lab Book",
    "files": [
      "src/**/*",
      "scripts/**/*",
      "agent-api.md",
      "skills/**/*",
      "package.json",
      "node_modules/pdfjs-dist/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office"
    },
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "katex": "0.19.1",
    "markdown-it": "15.0.3",
    "pdfjs-dist": "^4.10.38",
    "sanitize-html": "^2.18.2"
  },
  "engines": {
    "node": ">=22"
  }
}
